# Public portfolio demo: local fictitious fixtures, no database or cloud access.
COCKPIT_MODE=demo

# Only for a separately provisioned PRIVATE instance.
# Never copy production credentials into a demo project or test script.
# COCKPIT_MODE=private
# APP_URL=https://your-private-instance.example
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_CLIENT_KEY
# SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET
# COCKPIT_OWNER_EMAIL=owner@example.test
# Legacy alternative to SUPABASE_SECRET_KEY:
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
